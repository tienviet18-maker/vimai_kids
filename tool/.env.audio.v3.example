# ViMai Kids Audio V3 — environment example
# Copy to tool/.env.audio.v3 locally. NEVER commit real keys or service-account JSON.
# The Flutter app must not read these variables.

# Required provider for this phase
VIMAI_AUDIO_V3_PROVIDER=google_cloud

# Google Cloud project (no secret). Used with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=

# Application Default Credentials:
#   1) set GOOGLE_APPLICATION_CREDENTIALS to a local service-account JSON path, or
#   2) run: gcloud auth application-default login
# Do not put the JSON file inside this repository or Flutter assets.
GOOGLE_APPLICATION_CREDENTIALS=

# Voice names for Google Cloud TTS (Vietnamese only in tools/generate_audio_azure.py).
# Preferred: vi-VN-Neural2-A  |  Fallback in code: vi-VN-Wavenet-A
VI_VOICE_NAME=vi-VN-Neural2-A
JA_VOICE_NAME=
VI_LANGUAGE_CODE=vi-VN
JA_LANGUAGE_CODE=ja-JP

# Optional aliases (same rule: real Google voice names only)
VIMAI_AUDIO_V3_VI_VOICE_ID=
VIMAI_AUDIO_V3_JA_VOICE_ID=

# Not used by Google Cloud TTS. Kept empty so older docs stay valid.
VIMAI_AUDIO_V3_API_KEY=
VIMAI_AUDIO_V3_API_BASE=
VIMAI_AUDIO_V3_OPENAI_MODEL=
